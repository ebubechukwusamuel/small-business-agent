# Base URL for authentication email redirects.
NEXT_PUBLIC_SITE_URL=https://small-business-agent-ebubesamuel978-5695s-projects.vercel.app

# Required for sign-in and database access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local AI Gateway key only. Vercel-hosted deployments can use Vercel OIDC automatically.
# Do not put credentials in NEXT_PUBLIC_ variables or commit this file.
AI_GATEWAY_API_KEY=
AI_DRAFT_MODEL=anthropic/claude-haiku-4.5

# Apollo API key is server-only. Create it in Apollo Settings > Integrations > API Keys.
# The hosted app requires this before one-off sending and sequence status can connect.
APOLLO_API_KEY=
APOLLO_SEQUENCE_ID=6ada852777c0120014bc7dfc

# Set to true only after the Apollo sequence's subject lines and all message templates
# have been reviewed and approved in Apollo. Leave false/unset during setup.
APOLLO_SEQUENCE_READY=false
