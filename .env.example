# Base URL for auth redirects and Google OAuth callbacks.
NEXT_PUBLIC_SITE_URL=https://your-deployed-app.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AI Gateway: Vercel-hosted routes use the built-in VERCEL_OIDC_TOKEN.
# For local dev only, set an AI_GATEWAY_API_KEY in your private .env.local.
AI_GATEWAY_API_KEY=
AI_DRAFT_MODEL=anthropic/claude-haiku-4.5

# Gmail OAuth (server-only). Add Google credentials in Vercel Environment Variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-deployed-app.example/api/gmail/callback

# Required for server-only private token storage; NEVER use NEXT_PUBLIC_ for this.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32. Store only in Vercel secrets and local .env.local.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional Apollo sequence integration (separate from direct Gmail connection).
APOLLO_API_KEY=
APOLLO_SEQUENCE_ID=6ada852777c0120014bc7dfc
APOLLO_SEQUENCE_READY=false
