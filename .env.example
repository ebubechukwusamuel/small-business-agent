# Base URL for auth redirects and Google OAuth callbacks.
# Replace with the stable Vercel deployment domain configured in Google Cloud.
NEXT_PUBLIC_SITE_URL=https://your-deployed-app.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Vercel AI Gateway: hosted Vercel deployments use OIDC automatically.
# For local development, set AI_GATEWAY_API_KEY in your private .env.local.
AI_GATEWAY_API_KEY=
AI_DRAFT_MODEL=anthropic/claude-haiku-4.5

# Gmail OAuth (server-only). Add these as encrypted Vercel project environment variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; if empty, it is derived from NEXT_PUBLIC_SITE_URL + /api/gmail/callback.
GOOGLE_REDIRECT_URI=

# Encrypts Gmail access/refresh tokens stored in the workspace-scoped database.
# Generate with: openssl rand -base64 32. Store only in Vercel secrets and private .env.local.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional legacy Apollo sequence integration. Keep inactive until reviewed and explicitly approved.
APOLLO_API_KEY=
APOLLO_SEQUENCE_ID=6ada852777c0120014bc7dfc
APOLLO_SEQUENCE_READY=false
